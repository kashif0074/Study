# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/StudySpark?retryWrites=true&w=majority

# Backend server port
PORT=5000

# Secret for signing JWT authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# Path to the AI summarization model directory
MODEL_PATH=./models_cache/StudySpark_summarization
